# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Only permits HTTP loopback origins when explicitly required by a
# production-mode local smoke environment. Leave false in real production.
CORS_ALLOW_INSECURE_LOCALHOST=false

# PostgreSQL 16
# The local bootstrap example uses one disposable owner account. Production
# must replace these with separate runtime and migration credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employment_authority_v2
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employment_authority_v2
DATABASE_SSL=disable
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DB_READINESS_TIMEOUT_MS=2000
# Pre-created role name only; credentials remain in the connection URLs/secret
# store and are never passed to the provisioning command.
DATABASE_RUNTIME_ROLE=backend_v2_runtime

# Temporary Firebase Authentication bridge
# Firebase Admin uses Application Default Credentials. Keep credential files
# outside the repository and set GOOGLE_APPLICATION_CREDENTIALS only when the
# deployment environment does not provide workload credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
